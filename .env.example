# Copiar a .env y ajustar. Ninguna de estas variables es obligatoria:
# QASL-TDM arranca con SQLite y valores por defecto.

# --- Base de datos ---
# SQLite (por defecto, laboratorio)
# QASL_TDM_DATABASE_URL=sqlite:///./data/qasl_tdm.db

# PostgreSQL (concurrencia real, FOR UPDATE SKIP LOCKED)
# QASL_TDM_DATABASE_URL=postgresql+psycopg://qasl:qasl@localhost:5432/qasl_tdm

# --- Enmascaramiento ---
# Cambiar la sal rota todo el mapeo de valores enmascarados.
# En un entorno real vive en un secret manager, nunca en el repositorio.
QASL_TDM_MASKING_SALT=cambiar-en-cada-entorno

# --- Reservas ---
# Vida util por defecto de una reserva, en segundos.
QASL_TDM_DEFAULT_TTL=300

# Minimo de registros disponibles por escenario que mantiene REFRESH.
QASL_TDM_POOL_MIN=20
